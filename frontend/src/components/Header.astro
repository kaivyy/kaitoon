---
// Header.astro: Top application header with brand logo, pill search, and tabs
---

<header id="app-header" class="site-header">
  <div class="header-container">
    <div class="header-main-row">
      <div class="brand" id="brand-logo" role="button" tabindex="0" aria-label="Beranda Kaitoon">
        <svg class="brand-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path>
          <path d="M6 6h10"></path>
          <path d="M6 10h10"></path>
          <path d="M6 14h6"></path>
        </svg>
        <span class="brand-name">Kaitoon</span>
        <span class="brand-badge">Reader</span>
      </div>

      <div class="search-box">
        <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input type="search" id="search-input" placeholder="Cari judul komik..." aria-label="Cari judul komik" autocomplete="off">
        <button id="search-clear-btn" class="clear-btn" aria-label="Hapus pencarian" hidden>&times;</button>
      </div>
    </div>

    <nav class="nav-tabs" aria-label="Navigasi Utama">
      <button class="tab-btn active" id="tab-latest" data-tab="latest">
        <svg class="tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
        </svg>
        <span>Terbaru</span>
      </button>
      <button class="tab-btn" id="tab-favorites" data-tab="favorites">
        <svg class="tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
        </svg>
        <span>Favorit</span>
      </button>
      <button class="tab-btn" id="tab-history" data-tab="history">
        <svg class="tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <span>Riwayat</span>
      </button>
    </nav>
  </div>
</header>
