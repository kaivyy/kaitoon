---
// EpisodeDrawer.astro: Slide-up episode drawer sheet with search and chapter list
---

<!-- Drawer Popup Daftar Episode -->
<div id="episode-drawer" class="episode-drawer" hidden>
  <div class="episode-drawer-backdrop" id="episode-drawer-backdrop"></div>
  <div class="episode-drawer-panel">
    <div class="episode-drawer-header">
      <div class="episode-drawer-title-wrap">
        <h3 class="episode-drawer-title">Daftar Episode</h3>
        <span class="episode-drawer-subtitle" id="episode-drawer-comic-title"></span>
      </div>
      <button id="episode-drawer-close" class="btn btn-ghost drawer-close-btn" aria-label="Tutup daftar episode">&times;</button>
    </div>
    <div class="episode-drawer-search">
      <input type="search" id="episode-search-input" placeholder="Cari nomor chapter..." aria-label="Cari nomor chapter" autocomplete="off">
    </div>
    <div id="episode-drawer-list" class="episode-drawer-list" role="list">
      <slot />
    </div>
  </div>
</div>
