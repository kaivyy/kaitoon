---
// ReaderView.astro: Dual-mode reader container (webtoon continuous scroll and manga single-page slide)
---

<!-- Tampilan 3: Reader Komik (#reader-view) -->
<section id="reader-view" class="view-section reader-view" hidden>
  <!-- Auto-hiding Floating Header -->
  <header id="reader-header" class="reader-floating-bar reader-top-bar" role="toolbar" aria-label="Navigasi Reader Atas">
    <div class="reader-bar-left">
      <button id="reader-exit-btn" class="btn btn-secondary reader-btn-icon" title="Kembali ke Detail" aria-label="Kembali ke Detail">
        <svg class="btn-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <button id="reader-home-btn" class="btn btn-secondary reader-btn-icon" title="Beranda Katalog" aria-label="Beranda Katalog">
        <svg class="btn-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
      </button>
      <div class="reader-title-info">
        <span id="reader-manga-title" class="reader-comic-name"></span>
        <span id="reader-chapter-title" class="reader-ch-name"></span>
      </div>
    </div>
    <div class="reader-bar-right"></div>
  </header>

  <!-- Reader Stage Area -->
  <div id="reader-container" class="reader-stage">
    <!-- Mode Webtoon: Kontainer Gulir Vertikal -->
    <div id="webtoon-scroll-container" class="webtoon-container"></div>

    <!-- Mode Manga: Kontainer Slide Halaman Tunggal -->
    <div id="manga-slide-container" class="manga-container" hidden>
      <div class="tap-zone tap-zone-left" id="tap-prev" aria-label="Halaman Sebelumnya" title="Ketuk untuk Halaman Sebelumnya"></div>
      <div class="tap-zone tap-zone-center" id="tap-center" aria-label="Buka Menu Kontrol" title="Ketuk untuk Menu Kontrol"></div>
      <div class="tap-zone tap-zone-right" id="tap-next" aria-label="Halaman Berikutnya" title="Ketuk untuk Halaman Berikutnya"></div>
      <img id="manga-slide-img" class="manga-slide-img" alt="Halaman Manga" referrerpolicy="no-referrer">
    </div>
  </div>

  <!-- Auto-hiding Floating Footer Dock -->
  <footer id="reader-footer" class="reader-floating-bar reader-bottom-bar" role="toolbar" aria-label="Navigasi Reader Bawah">
    <div class="reader-bottom-dock">
      <button id="reader-dock-home-btn" class="btn btn-secondary reader-btn-icon reader-dock-pill-btn" aria-label="Beranda Katalog" title="Beranda Katalog">
        <svg class="btn-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
      </button>

      <button id="reader-prev-chapter" class="btn btn-secondary reader-nav-btn reader-btn-icon reader-dock-pill-btn" aria-label="Chapter Sebelumnya" title="Chapter Sebelumnya">
        <svg class="btn-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <!-- Button Chapter Floating pembuka drawer episode (Icon Burger seperti Shinigami) -->
      <button id="reader-chapter-dock-btn" class="btn btn-secondary reader-chapter-dock-btn reader-dock-pill-btn" aria-label="Buka Daftar Episode" title="Daftar Chapter (Burger Menu)">
        <svg class="btn-icon-svg reader-burger-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="4" y1="6" x2="20" y2="6"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="18" x2="20" y2="18"></line>
        </svg>
        <span id="reader-dock-chapter-text" class="reader-dock-chapter-text">Chapter</span>
        <svg class="btn-icon-svg chevron-down-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </button>

      <!-- Hidden select for backward compatibility with test client -->
      <select id="reader-chapter-select" class="chapter-select" aria-label="Pilih Chapter" hidden></select>

      <button id="reader-next-chapter" class="btn btn-secondary reader-nav-btn reader-btn-icon reader-dock-pill-btn" aria-label="Chapter Berikutnya" title="Chapter Berikutnya">
        <svg class="btn-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>

      <!-- Pemisah Vertikal Dock -->
      <div class="reader-dock-divider" aria-hidden="true"></div>

      <!-- Button Auto Scroll Play/Pause -->
      <button id="reader-autoscroll-btn" class="btn btn-secondary reader-dock-pill-btn reader-autoscroll-btn" aria-label="Putar Auto Scroll" title="Auto Scroll (Spasi)">
        <svg id="reader-autoscroll-icon-play" class="btn-icon-svg" viewBox="0 0 24 24" fill="currentColor">
          <polygon points="5 3 19 12 5 21 5 3"></polygon>
        </svg>
        <svg id="reader-autoscroll-icon-pause" class="btn-icon-svg" viewBox="0 0 24 24" fill="currentColor" hidden>
          <rect x="6" y="4" width="4" height="16" rx="1"></rect>
          <rect x="14" y="4" width="4" height="16" rx="1"></rect>
        </svg>
        <span id="reader-autoscroll-text" class="reader-autoscroll-text">Auto</span>
      </button>

      <!-- Button Pengaturan Kecepatan Scroll -->
      <button id="reader-speed-btn" class="btn btn-secondary reader-dock-pill-btn reader-speed-btn" aria-label="Pengaturan Kecepatan Auto Scroll" title="Pengaturan Kecepatan Auto Scroll">
        <span id="reader-dock-speed-text" class="reader-speed-badge">1.0x</span>
        <svg class="btn-icon-svg reader-gear-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
        </svg>
      </button>

      <button id="reader-prev-page" class="btn btn-secondary manga-nav-btn reader-btn-icon reader-dock-pill-btn" aria-label="Halaman Sebelumnya" title="Halaman Sebelumnya" hidden>
        <svg class="btn-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <span id="reader-page-counter" class="page-counter" hidden>Hal 1 / 1</span>

      <button id="reader-next-page" class="btn btn-secondary manga-nav-btn reader-btn-icon reader-dock-pill-btn" aria-label="Halaman Berikutnya" title="Halaman Berikutnya" hidden>
        <svg class="btn-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  </footer>

  <!-- Floating Autoscroll Status Pill (Hanya muncul saat auto scroll aktif) -->
  <div id="autoscroll-floating-pill" class="autoscroll-floating-pill" hidden>
    <button id="floating-autoscroll-toggle" class="floating-pill-btn" aria-label="Jeda Auto Scroll" title="Jeda (Spasi)">
      <span class="pulsing-emerald-dot" aria-hidden="true"></span>
      <svg class="pill-icon-svg" viewBox="0 0 24 24" fill="currentColor">
        <rect x="6" y="4" width="4" height="16" rx="1"></rect>
        <rect x="14" y="4" width="4" height="16" rx="1"></rect>
      </svg>
      <span>Auto Scroll</span>
    </button>
    <button id="floating-speed-btn" class="floating-pill-speed" aria-label="Ubah Kecepatan" title="Ubah Kecepatan">
      <span id="floating-speed-text">1.0x</span>
    </button>
  </div>

  <!-- Modal Pengaturan Auto Scroll -->
  <div id="autoscroll-modal" class="autoscroll-modal-backdrop" hidden>
    <div class="autoscroll-modal-card" role="dialog" aria-modal="true" aria-labelledby="autoscroll-modal-title">
      <div class="autoscroll-modal-header">
        <div class="autoscroll-modal-title-wrap">
          <svg class="modal-title-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          <h3 id="autoscroll-modal-title" class="autoscroll-modal-title">Kecepatan Auto Scroll</h3>
        </div>
        <button id="autoscroll-modal-close" class="btn btn-secondary modal-close-btn" aria-label="Tutup Pengaturan">
          <svg class="btn-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <div class="autoscroll-modal-body">
        <div class="speed-indicator-wrap">
          <span class="speed-indicator-label">Kecepatan Terpilih:</span>
          <span id="speed-indicator-val" class="speed-indicator-val">1.0x</span>
        </div>

        <div class="speed-slider-wrap">
          <input type="range" id="autoscroll-speed-slider" class="speed-slider" min="50" max="200" step="25" value="100" aria-label="Geser kecepatan scroll">
          <div class="speed-ticks">
            <span>0.5x</span>
            <span>0.75x</span>
            <span>1.0x</span>
            <span>1.25x</span>
            <span>1.5x</span>
            <span>2.0x</span>
          </div>
        </div>

        <div class="speed-presets-label">Pilihan Cepat (Preset):</div>
        <div class="speed-presets-grid">
          <button type="button" class="btn speed-preset-btn" data-speed="0.5">0.5x</button>
          <button type="button" class="btn speed-preset-btn" data-speed="0.75">0.75x</button>
          <button type="button" class="btn speed-preset-btn active" data-speed="1.0">1.0x</button>
          <button type="button" class="btn speed-preset-btn" data-speed="1.25">1.25x</button>
          <button type="button" class="btn speed-preset-btn" data-speed="1.5">1.5x</button>
          <button type="button" class="btn speed-preset-btn" data-speed="2.0">2.0x</button>
        </div>

        <div class="autoscroll-modal-actions">
          <button type="button" id="modal-autoscroll-toggle-btn" class="btn btn-primary modal-play-btn">
            <svg id="modal-play-icon" class="btn-icon-svg" viewBox="0 0 24 24" fill="currentColor">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
            <span id="modal-play-text">Mulai Auto Scroll</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <slot />
</section>
