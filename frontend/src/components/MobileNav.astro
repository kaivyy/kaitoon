---
// MobileNav.astro: Mobile bottom navigation bar with OLED glassmorphism
---

<nav id="mobile-bottom-nav" class="mobile-bottom-nav" aria-label="Navigasi Bawah Ponsel">
  <button class="mobile-nav-btn active" id="mobile-tab-latest" data-tab="latest" aria-label="Komik Terbaru">
    <svg class="mobile-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
    </svg>
    <span class="mobile-nav-label">Terbaru</span>
  </button>
  <button class="mobile-nav-btn" id="mobile-tab-favorites" data-tab="favorites" aria-label="Komik Favorit">
    <svg class="mobile-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
    </svg>
    <span class="mobile-nav-label">Favorit</span>
  </button>
  <button class="mobile-nav-btn" id="mobile-tab-history" data-tab="history" aria-label="Riwayat Baca">
    <svg class="mobile-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="10"></circle>
      <polyline points="12 6 12 12 16 14"></polyline>
    </svg>
    <span class="mobile-nav-label">Riwayat</span>
  </button>
</nav>
