---
// ComicGrid.astro: Catalog view section with responsive comic grid and pagination dock
interface Props {
  title?: string;
  count?: string;
}

const { title = "Komik Terbaru", count = "" } = Astro.props;
---

<section id="catalog-view" class="view-section">
  <div class="view-header">
    <div class="view-header-title-group">
      <h2 id="catalog-title" class="view-title">{title}</h2>
      <span id="catalog-count" class="view-subtitle view-count">{count}</span>
    </div>
  </div>
  <div id="comic-grid" class="comic-grid" role="list">
    <slot />
  </div>
  <div id="pagination-controls" class="pagination-bar pagination-dock" hidden>
    <button id="prev-page-btn" class="btn btn-pagination" disabled aria-label="Halaman Sebelumnya">
      <svg class="btn-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
      <span>Sebelumnya</span>
    </button>
    <div class="pagination-badge-wrap">
      <span id="page-num-display" class="page-indicator-text">Halaman 1</span>
    </div>
    <button id="next-page-btn" class="btn btn-pagination" aria-label="Halaman Selanjutnya">
      <span>Selanjutnya</span>
      <svg class="btn-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  </div>

  <!-- Server Switcher (Pilihan Server Paling Bawah) -->
  <div id="server-switcher-bar" class="server-switcher-bar" aria-label="Pilihan Server Sumber Komik">
    <div class="server-switcher-label">
      <svg class="server-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
        <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
        <line x1="6" y1="6" x2="6.01" y2="6"></line>
        <line x1="6" y1="18" x2="6.01" y2="18"></line>
      </svg>
      <span>Server Sumber:</span>
    </div>
    <div class="server-btn-group" role="radiogroup" aria-label="Pilih Server Komik">
      <button
        type="button"
        id="server-btn-shinigami"
        class="server-pill-btn active"
        data-server="shinigami"
        role="radio"
        aria-checked="true"
        aria-label="Server 1: Shinigami"
      >
        <span class="server-indicator-dot"></span>
        <span class="server-pill-text">Server 1 (Shinigami)</span>
      </button>
      <button
        type="button"
        id="server-btn-komiku"
        class="server-pill-btn"
        data-server="komiku"
        role="radio"
        aria-checked="false"
        aria-label="Server 2: Komiku.org"
      >
        <span class="server-indicator-dot"></span>
        <span class="server-pill-text">Server 2 (Komiku)</span>
      </button>
    </div>
  </div>
</section>
