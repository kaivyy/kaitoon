---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Kaitoon Web Reader",
  description = "Kaitoon Web Reader: Pembaca komik webtoon dan manga bebas iklan dengan tema OLED Pure Black."
} = Astro.props;

import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <meta name="color-scheme" content="dark">
  <title>{title}</title>
  <script is:inline>
    (function() {
      try {
        var raw = window.location.hash || '';
        if (!raw) {
          raw = sessionStorage.getItem('kaitoon_route') || localStorage.getItem('kaitoon_route') || '';
        }
        var clean = raw.replace(/^#\/?/, '');
        if (clean.indexOf('reader') === 0) {
          document.documentElement.classList.add('route-reader-initial');
        } else if (clean.indexOf('manga') === 0) {
          document.documentElement.classList.add('route-detail-initial');
        }
      } catch (e) {}
    })();
  </script>
</head>
<body>
  <slot />
</body>
</html>
